# Postgres. docker-compose.yml's container matches this default.
DATABASE_URL="postgresql://hidecraft:hidecraft_local_dev@localhost:5435/hidecraft"
# Used by `prisma migrate` only. On a pooled host (Supabase) this must be the
# direct, unpooled connection string; locally it is the same as DATABASE_URL.
DIRECT_URL="postgresql://hidecraft:hidecraft_local_dev@localhost:5435/hidecraft"
AUTH_SECRET="replace-with-a-long-random-string"
ADMIN_API_KEY="replace-with-a-long-random-admin-key"
# The storefront's origin — used for CORS and for links in email.
NEXT_PUBLIC_STORE_URL="http://localhost:3911"
NEXT_PUBLIC_BRAND_NAME="Hidecraft"
# Needed for image uploads (product photos, Customize reference photos, chat).
# Create two PUBLIC buckets named `product-images` and `chat-images`.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
# Razorpay Standard Checkout (test-mode keys). KEY_SECRET lives only here.
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="replace-with-your-key-secret"
RAZORPAY_WEBHOOK_SECRET="replace-with-your-webhook-secret"
# Optional: order-confirmation email via Resend.
RESEND_API_KEY=""
ORDER_EMAIL_FROM="Hidecraft <orders@your-domain.example>"
ORDER_EMAIL_REPLY_TO="support@your-domain.example"
# Optional: Google sign-in for customers.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ADMIN_API_URL="http://localhost:3910"
